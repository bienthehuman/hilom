# Copy to .env for local overrides. The defaults below work out of the box.
# These credentials are for local development only.
HILOM_DB_PORT=5432
HILOM_DB_NAME=hilom
HILOM_DB_USER=hilom
HILOM_DB_PASSWORD=hilom_dev
# The API's own login (role hilom_app: no UPDATE/DELETE on the audit log). Unset = the API uses the owner above.
HILOM_DB_APP_PASSWORD=hilom_app_dev
HILOM_MAIL_SMTP_PORT=1025
HILOM_MAIL_UI_PORT=8025
